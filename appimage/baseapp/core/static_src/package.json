{
  "name": "django-template-assets",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:clean && npm run build:tailwind && npm run build:vendor",
    "build:clean": "rimraf ../static/css/dist ../static/js/htmx.min.js ../static/js/alpine.min.js ../static/js/chart.umd.min.js ../static/js/chart.umd.min.js.map",
    "build:tailwind": "tailwindcss --postcss -i ./src/styles.css -o ../static/css/dist/styles.css --minify",
    "build:vendor": "mkdir -p ../static/js && cp ./node_modules/htmx.org/dist/htmx.min.js ../static/js/htmx.min.js && cp ./node_modules/@alpinejs/csp/dist/cdn.min.js ../static/js/alpine.min.js && cp ./node_modules/chart.js/dist/chart.umd.min.js ../static/js/chart.umd.min.js && cp ./node_modules/chart.js/dist/chart.umd.min.js.map ../static/js/chart.umd.min.js.map",
    "dev": "tailwindcss --postcss -i ./src/styles.css -o ../static/css/dist/styles.css -w"
  },
  "devDependencies": {
    "@alpinejs/csp": "^3.15.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "chart.js": "4.5.0",
    "htmx.org": "^2.0.4",
    "postcss": "^8.5.4",
    "postcss-import": "^16.1.0",
    "postcss-nested": "^6.2.0",
    "rimraf": "^5.0.10",
    "tailwindcss": "^3.4.17"
  }
}
